// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database declared
// below, writes the real database_id into your copy of the repo, and wires the repo to Workers
// Builds so every push to main redeploys (build: `npm run build`, deploy: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid: the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blankspace-answer-engine",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blankspace-answer-engine-db",
      "database_id": "41bdb7ae-2299-4a3d-9253-8ee86f6aa528"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RUN_TICKER", "class_name": "RunTicker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunTicker"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Live runs anyone may start per 24 hours. The owner (admin password) is not limited.
    "DAILY_RUN_LIMIT": "12",
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # owner-only Settings, vertical runs and draft edits
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
}
